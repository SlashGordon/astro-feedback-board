{
  "name": "astro-feedback-board-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply feedback --local",
    "db:migrate:remote": "wrangler d1 migrations apply feedback --remote",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:seed:local": "wrangler d1 execute feedback --local --file seed/dev.sql"
  },
  "dependencies": {
    "astro-feedback-board": "*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260924.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.138.0"
  }
}
